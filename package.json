{
  "name": "pi-runs",
  "version": "0.2.0",
  "description": "Pi integration for durable long-running scientific Runs managed by runwatch.",
  "type": "module",
  "license": "MIT",
  "files": [
    "extensions/",
    "src/",
    "scripts/",
    "skills/",
    "assets/"
  ],
  "keywords": [
    "pi-package",
    "hpc",
    "slurm",
    "lsf",
    "runwatch",
    "scientific-computing"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "accept:release": "node scripts/acceptance/pi_v1_release.mjs",
    "accept:soak": "node scripts/acceptance/pi_v1_soak.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": ["./extensions/runs/index.ts"],
    "skills": ["./skills"]
  }
}
